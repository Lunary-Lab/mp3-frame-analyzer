{
  "name": "mp3-frame-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streaming TypeScript API for counting MPEG-1 Layer III frames",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.lint.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\" vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:memory": "npm run build --silent && node --expose-gc scripts/memory-benchmark.mjs",
    "test:fuzz": "npm run build --silent && node scripts/fuzz-parser.mjs && npm run test:fuzz-tooling",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "audit:dependencies": "npm audit --audit-level=high",
    "hooks:install": "lefthook install",
    "fuzz:coverage": "npm run build --silent && node scripts/run-jazzer.mjs",
    "fuzz:regression": "npm run build --silent && node scripts/run-jazzer.mjs --regression",
    "fuzz:extended": "npm run build --silent && node scripts/run-jazzer.mjs --extended",
    "fuzz:minimize": "node scripts/minimize-fuzz-crash.mjs",
    "test:fuzz-tooling": "node --test scripts/minimize-core.test.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.6",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@jazzer.js/core": "4.0.0"
  }
}
