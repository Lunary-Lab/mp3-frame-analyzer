{
  "name": "mp3-frame-analyzer",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "Streaming TypeScript API for counting MPEG-1 Layer III frames",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.lint.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:memory": "npm run build --silent && node --expose-gc scripts/memory-benchmark.mjs",
    "test:performance": "npm run build --silent && node scripts/http-performance.mjs",
    "test:fuzz": "npm run build --silent && node scripts/fuzz-parser.mjs && npm run test:fuzz-tooling",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:legacy && npm run test:mutation-policy && npm run test:coverage && npm run test:tooling && npm run build",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "hooks:install": "lefthook install",
    "fuzz:coverage": "npm run build --silent && node scripts/run-jazzer.mjs",
    "fuzz:regression": "npm run build --silent && node scripts/run-jazzer.mjs --regression",
    "fuzz:extended": "npm run build --silent && node scripts/run-jazzer.mjs --extended",
    "fuzz:minimize": "node scripts/minimize-fuzz-crash.mjs",
    "test:fuzz-tooling": "node --test scripts/minimize-core.test.mjs",
    "typecheck:legacy": "tsc6 --project tsconfig.lint.json --noEmit",
    "test:mutation:unit": "vitest run --config vitest.mutation.config.ts --bail=1",
    "mutation": "node scripts/run-mutations.mjs",
    "verify:sample": "npm run build --silent && node scripts/verify-sample.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:artifact": "node scripts/verify-artifact.mjs",
    "test:mutation-policy": "node --test scripts/mutation-policy*.test.mjs",
    "mutation:full": "node scripts/run-mutations.mjs --full",
    "mutation:pure": "node -e \"require('node:fs').rmSync('reports/mutation-pure', { recursive: true, force: true })\" && stryker run stryker.nonparser-pure.config.mjs && node scripts/nonparser-pure-scope.mjs reports/mutation-pure/mutation.json",
    "test:mutation-cache": "node --test scripts/mutation-cache.test.mjs",
    "test:mutation-cache:integration": "node --test scripts/native-mutation.integration.mjs",
    "sast:runtime": "node scripts/runtime-architecture.mjs",
    "test:sast": "node --test scripts/runtime-architecture*.test.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.6",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@jazzer.js/core": "4.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "yaml": "2.9.1",
    "@eslint-community/eslint-utils": "4.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@hyperjump/json-schema-formats": "1.1.0"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  }
}
