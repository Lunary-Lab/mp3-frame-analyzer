// ruleid: mp3-api-no-dynamic-code-execution
eval('fixture');
// ruleid: mp3-api-no-dynamic-code-execution
new Function('return "fixture"');
// ruleid: mp3-api-no-shell-command-execution
execSync('fixture');
// ruleid: mp3-api-no-shell-command-execution
exec('fixture');
// ruleid: mp3-api-no-shell-command-execution
spawn('fixture');

// ok: mp3-api-no-dynamic-code-execution
JSON.parse('{"fixture":true}');
// ok: mp3-api-no-dynamic-code-execution
const dynamicLabel = 'eval("fixture"); new Function("fixture")';
// ok: mp3-api-no-shell-command-execution
