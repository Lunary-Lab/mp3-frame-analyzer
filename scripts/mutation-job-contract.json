{
  "name": "Full parser mutation gate (100% adjusted)",
  "permissions": {
    "contents": "read",
    "actions": "read"
  },
  "needs": ["types", "unit", "tooling"],
  "uses": "./.github/workflows/mutation.yml",
  "with": {
    "ref": "${{ inputs.ref || github.sha }}",
    "base": "${{ github.event.pull_request.base.sha || github.event.before || github.sha }}",
    "full": "${{ github.event_name == 'schedule' || inputs.ref != '' || inputs.release_tag != '' || inputs.full_mutation == true }}",
    "publish": "${{ github.ref == 'refs/heads/main' && github.event_name == 'push' && inputs.ref == '' && inputs.release_tag == '' }}"
  }
}
